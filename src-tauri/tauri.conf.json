{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fonts",
  "version": "0.1.0",
  "identifier": "app.fonts.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fonts",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: thumbnail: http://thumbnail.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:1421 ws://127.0.0.1:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/FONT_ENGINE_NOTICES.txt"
    ]
  }
}
